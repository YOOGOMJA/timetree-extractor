{
  "name": "timetree-exporter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle:content-script",
    "bundle:content-script": "esbuild src/extension/content-script.ts --bundle --format=iife --platform=browser --target=chrome121 --outfile=dist/src/extension/content-script.bundle.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
    "@types/sql.js": "^1.4.11",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  }
}
