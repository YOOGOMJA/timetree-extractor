{
  "manifest_version": 3,
  "name": "TimeTree Exporter",
  "version": "0.1.0",
  "description": "TimeTree 캘린더 이벤트를 ICS/JSON으로 내보냅니다",
  "minimum_chrome_version": "121",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://timetreeapp.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://timetreeapp.com/*"],
      "js": ["dist/src/extension/content-script.bundle.js"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "TimeTree Exporter 열기",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "dist/src/extension/background.js",
    "type": "module"
  }
}
